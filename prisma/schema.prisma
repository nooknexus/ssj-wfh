generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  staff
  leader
  hradmin
  itadmin
  superadmin
}

enum UserStatus {
  pending
  active
  inactive
}

enum WfhStatus {
  pending
  approved
  rejected
}

enum LeaveStatus {
  pending
  step1_approved
  approved
  rejected
  cancelled
}

enum BookingStatus {
  pending
  approved
  rejected
  cancelled
}

enum ConferencePlatform {
  zoom
  teams
  meet
  webex
  other
}

enum DocType {
  inbound
  outbound
  order
  memo
}

enum DocStatus {
  new
  pending
  in_progress
  completed
}

enum WorkType {
  wfh
  office
  official_trip
  onsite
}

enum ExceptionType {
  leave
  official_trip
}

enum DayPeriod {
  full
  morning
  afternoon
}

enum ExceptionStatus {
  pending
  approved
  rejected
  cancelled
}

enum AttendanceStatus {
  on_time
  late
  absent
  leave
}

model User {
  id          Int        @id @default(autoincrement())
  provider_id String?    @unique @db.VarChar(50)
  hash_cid    String?    @db.VarChar(128)
  username    String?    @db.VarChar(20)
  name_th     String?    @db.VarChar(200)
  name_eng    String?    @db.VarChar(200)
  email       String?    @db.VarChar(200)
  title_th    String?    @db.VarChar(50)
  position    String?    @db.VarChar(200)
  hcode       String?    @db.VarChar(10)
  hname       String?    @db.VarChar(200)
  /// Deprecated: ใช้ตาราง user_roles แทน คงไว้เพื่อ rollback จะลบใน release ถัดไป
  role        Role       @default(staff)
  roles       UserRole[]

  department_id Int?
  department    Department? @relation(fields: [department_id], references: [id])

  status     UserStatus @default(pending)
  avatar_url String?    @db.VarChar(500)
  phone      String?    @db.VarChar(20)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  leave_quotas          LeaveQuota[]
  leave_requests        LeaveRequest[]
  step1_approvals       LeaveRequest[]        @relation("Step1Approver")
  step2_approvals       LeaveRequest[]        @relation("Step2Approver")
  meeting_bookings      MeetingBooking[]      @relation("BookingUser")
  approved_bookings     MeetingBooking[]      @relation("BookingApprover")
  assigned_docs         Document[]            @relation("AssignedTo")
  assigned_by_docs      Document[]            @relation("AssignedBy")
  created_docs          Document[]            @relation("DocCreatedBy")
  uploaded_attachments  DocumentAttachment[]
  attendance_records    AttendanceRecord[]
  weekly_plans          WeeklyPlan[]
  wfh_requests          WfhRequest[]          @relation("WfhUser")
  approved_wfh          WfhRequest[]          @relation("WfhApprover")
  attendance_exceptions AttendanceException[] @relation("ExceptionUser")
  approved_exceptions   AttendanceException[] @relation("ExceptionApprover")

  @@map("users")
}

/// บทบาทเพิ่มเติมของผู้ใช้ (ทุกคนเป็น staff โดยปริยาย ไม่ต้องเก็บแถว staff)
model UserRole {
  id         Int      @id @default(autoincrement())
  user_id    Int
  role       Role
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role])
  @@map("user_roles")
}

model Department {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(200)
  code       String?  @db.VarChar(20)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  users            User[]
  meeting_bookings MeetingBooking[]
  documents        Document[]

  @@map("departments")
}

model LeaveType {
  id         Int     @id @default(autoincrement())
  name       String  @db.VarChar(100)
  code       String  @db.VarChar(20)
  max_days   Int?
  is_active  Boolean @default(true)
  sort_order Int     @default(0)

  quotas   LeaveQuota[]
  requests LeaveRequest[]

  @@map("leave_types")
}

model LeaveQuota {
  id            Int       @id @default(autoincrement())
  user_id       Int
  user          User      @relation(fields: [user_id], references: [id])
  leave_type_id Int
  leave_type    LeaveType @relation(fields: [leave_type_id], references: [id])
  fiscal_year   Int
  total_days    Decimal   @db.Decimal(5, 1)
  used_days     Decimal   @default(0) @db.Decimal(5, 1)
  created_at    DateTime  @default(now())

  @@map("leave_quotas")
}

model LeaveRequest {
  id            Int       @id @default(autoincrement())
  user_id       Int?
  user          User?     @relation(fields: [user_id], references: [id])
  external_name String?   @db.VarChar(200)
  cid           String?   @db.VarChar(13)
  leave_type_id Int
  leave_type    LeaveType @relation(fields: [leave_type_id], references: [id])
  start_date    DateTime  @db.Date
  end_date      DateTime  @db.Date
  total_days    Decimal   @db.Decimal(5, 1)
  reason        String?   @db.Text

  // Step 1
  step1_status   LeaveStatus @default(pending)
  step1_by       Int?
  step1_approver User?       @relation("Step1Approver", fields: [step1_by], references: [id])
  step1_reason   String?     @db.Text
  step1_at       DateTime?

  // Step 2
  step2_status   LeaveStatus @default(pending)
  step2_by       Int?
  step2_approver User?       @relation("Step2Approver", fields: [step2_by], references: [id])
  step2_reason   String?     @db.Text
  step2_at       DateTime?

  status LeaveStatus @default(pending)

  /// แหล่งข้อมูลที่ Sync มา เช่น "leave_mysql" และ id ของแถวในระบบต้นทาง ใช้กันข้อมูลซ้ำ
  source           String? @db.VarChar(30)
  source_record_id String? @db.VarChar(64)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([source, source_record_id])
  @@map("leave_requests")
}

model WfhRequest {
  id         Int      @id @default(autoincrement())
  user_id    Int
  user       User     @relation("WfhUser", fields: [user_id], references: [id])
  start_date DateTime @db.Date
  end_date   DateTime @db.Date
  reason     String?  @db.Text

  status        WfhStatus @default(pending)
  approved_by   Int?
  approver      User?     @relation("WfhApprover", fields: [approved_by], references: [id])
  approved_at   DateTime?
  reject_reason String?   @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("wfh_requests")
}

model ConferenceLink {
  id               Int                @id @default(autoincrement())
  name             String             @db.VarChar(200)
  platform         ConferencePlatform
  url              String             @db.VarChar(1000)
  max_participants Int?
  description      String?            @db.Text
  is_active        Boolean            @default(true)
  sort_order       Int                @default(0)
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  bookings         MeetingBooking[]

  @@map("conference_links")
}

model MeetingBooking {
  id            Int            @id @default(autoincrement())
  link_id       Int
  link          ConferenceLink @relation(fields: [link_id], references: [id])
  user_id       Int
  user          User           @relation("BookingUser", fields: [user_id], references: [id])
  department_id Int?
  department    Department?    @relation(fields: [department_id], references: [id])

  title       String   @db.VarChar(500)
  description String?  @db.Text
  start_at    DateTime
  end_at      DateTime
  attendees   Int?

  status        BookingStatus @default(pending)
  approved_by   Int?
  approver      User?         @relation("BookingApprover", fields: [approved_by], references: [id])
  approved_at   DateTime?
  reject_reason String?       @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([link_id, start_at])
  @@map("meeting_bookings")
}

model Document {
  id         Int       @id @default(autoincrement())
  doc_type   DocType
  doc_number String?   @db.VarChar(100)
  from_to    String?   @db.VarChar(500)
  subject    String    @db.Text
  doc_date   DateTime? @db.Date

  assigned_to Int?
  assignee    User? @relation("AssignedTo", fields: [assigned_to], references: [id])
  assigned_by Int?
  assigner    User? @relation("AssignedBy", fields: [assigned_by], references: [id])

  department_id Int?
  department    Department? @relation(fields: [department_id], references: [id])

  status DocStatus @default(new)
  remark String?   @db.Text

  created_by Int
  creator    User @relation("DocCreatedBy", fields: [created_by], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  attachments DocumentAttachment[]

  @@map("documents")
}

model DocumentAttachment {
  id          Int      @id @default(autoincrement())
  document_id Int
  document    Document @relation(fields: [document_id], references: [id], onDelete: Cascade)
  file_name   String   @db.VarChar(500)
  file_path   String   @db.VarChar(1000)
  file_size   Int?
  mime_type   String?  @db.VarChar(100)

  uploaded_by Int
  uploader    User @relation(fields: [uploaded_by], references: [id])

  created_at DateTime @default(now())

  @@map("document_attachments")
}

model AttendanceRecord {
  id        Int      @id @default(autoincrement())
  user_id   Int
  user      User     @relation(fields: [user_id], references: [id])
  date      DateTime @db.Date
  work_type WorkType

  check_in_time  DateTime?
  check_out_time DateTime?
  check_in_lat   Decimal?  @db.Decimal(10, 8)
  check_in_lng   Decimal?  @db.Decimal(11, 8)
  check_out_lat  Decimal?  @db.Decimal(10, 8)
  check_out_lng  Decimal?  @db.Decimal(11, 8)

  status         AttendanceStatus @default(on_time)
  tasks          String?          @db.Text
  mission_detail String?          @db.Text
  /// หมายเหตุ/เหตุผลที่ผู้ใช้กรอกเอง เช่น เหตุผลที่มาสาย
  remark         String?          @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  photos AttendancePhoto[]

  @@map("attendance_records")
}

model AttendancePhoto {
  id            Int              @id @default(autoincrement())
  attendance_id Int
  attendance    AttendanceRecord @relation(fields: [attendance_id], references: [id], onDelete: Cascade)
  file_name     String           @db.VarChar(500)
  file_path     String           @db.VarChar(1000)
  file_size     Int?

  created_at DateTime @default(now())

  @@map("attendance_photos")
}

model WeeklyPlan {
  id         Int      @id @default(autoincrement())
  user_id    Int
  user       User     @relation(fields: [user_id], references: [id])
  week_start DateTime @db.Date
  plan_data  Json

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("weekly_plans")
}

model SystemSetting {
  id            Int    @id @default(autoincrement())
  setting_key   String @unique @db.VarChar(100)
  setting_value String @db.Text

  updated_at DateTime @updatedAt

  @@map("system_settings")
}

/// ข้อยกเว้นการลงเวลา (แจ้งลา / ไปราชการ) จากหน้าแผนงานรายสัปดาห์ ไม่เกี่ยวกับ leave_requests
model AttendanceException {
  id             Int             @id @default(autoincrement())
  user_id        Int
  user           User            @relation("ExceptionUser", fields: [user_id], references: [id])
  date           DateTime        @db.Date
  type           ExceptionType
  period         DayPeriod       @default(full)
  reason         String?         @db.Text
  location       String?         @db.VarChar(255)
  attachment_url String?         @db.VarChar(500)
  status         ExceptionStatus @default(pending)
  approved_by    Int?
  approver       User?           @relation("ExceptionApprover", fields: [approved_by], references: [id])
  approved_at    DateTime?
  reject_reason  String?         @db.Text
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt

  @@index([user_id, date])
  @@index([date, status])
  @@map("attendance_exceptions")
}
